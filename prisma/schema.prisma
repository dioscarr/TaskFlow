generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  tasks         Task[]
  workflows     Workflow[]
  files         WorkspaceFile[]
  prompts       AIPromptSet[]
  alegraBills   AlegraBill[]
  chatSessions  ChatSession[]
  intentRules   IntentRule[]
  activities    AgentActivity[]
  agentJobs    AgentJob[]
  protoData     PrototypeData[]
  skills        Skill[]
  processes     ProcessRegistry[]
  toolConfigs   ToolConfiguration[]
  appDeployments AppDeployment[]
  
  // Profile & Settings
  profile       UserProfile?
  appSettings   AppSettings[]
  appResources  AppResource[]
  credentials   ResourceCredential[]
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model IntentRule {
  id        String   @id @default(cuid())
  name      String
  action    String
  keywords  String[]
  enabled   Boolean  @default(true)
  config    Json?
  steps     Json?    // Array of WorkflowStep: { id, action, params }

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
 
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime
 
  @@unique([identifier, token])
}

// Application Specific Models

model Task {
  id          String   @id @default(cuid())
  title       String
  description String?
  status      String   @default("pending") // pending, completed
  dueDate     DateTime?
  
  // Link to original email if applicable
  emailId     String?  // GMail Message ID
  emailSource String?  // JSON blob of email metadata

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Workflow {
  id        String   @id @default(cuid())
  name      String
  trigger   String   // e.g., "manual", "email_keyword"
  action    String   // e.g., "create_sheet", "calendar_event"
  config    String?  // JSON config for the action

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WorkspaceFile {
  id        String   @id @default(cuid())
  name      String
  type      String   // folder, pdf, image, etc.
  size      String?
  items     String?  // For folders
  shared    Boolean  @default(false)
  order     Float    @default(0)

  highlightBgColor     String?
  highlightTextColor   String?
  highlightBorderColor String?
  highlightFontWeight  String?

  parentId  String?
  parent    WorkspaceFile?    @relation("FolderContents", fields: [parentId], references: [id], onDelete: Cascade)
  children  WorkspaceFile[]   @relation("FolderContents")

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  alegraBill AlegraBill?
  appDeployments AppDeployment[]

  tags      String[] @default([])
  storagePath String?
  magicRule String?  // 'invoices', 'cleanup', etc.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AppDeployment {
  id             String   @id @default(cuid())
  appId          String
  app            WorkspaceFile @relation(fields: [appId], references: [id], onDelete: Cascade)

  internalDomain String
  port           Int
  containerName  String
  imageName      String
  status         String   @default("running") // running, failed, stopped
  logs           String?  @db.Text

  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model AIPromptSet {
  id              String   @id @default(cuid())
  name            String   @unique
  description     String?
  prompt          String   @db.Text
  isActive        Boolean  @default(false)
  tools           String[] @default([]) // Array of tool IDs from tool library
  workflows       Json?    // Array of WorkflowStep
  triggerKeywords String[] @default([]) // Keywords to trigger the workflow
  
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AlegraBill {
  id              String   @id @default(cuid())
  date            String
  dueDate         String
  providerName    String
  providerId      String?
  identification  String?
  ncf             String?
  items           String   @db.Text // JSON blob
  observations    String?  @db.Text
  totalAmount     Float
  status          String   @default("draft") // draft, exported
  
  // DGII Verification
  isVerified      Boolean  @default(false)
  verifiedName    String?
  ncfType         String?  // 01-10 classification

  fileId          String?  @unique
  file            WorkspaceFile? @relation(fields: [fileId], references: [id])

  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ChatSession {
  id          String   @id @default(cuid())
  title       String   @default("New Chat")
  messages    ChatMessage[]
  agentJobs   AgentJob[]
  activities  AgentActivity[]
  
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ChatMessage {
  id          String   @id @default(cuid())
  role        String   // 'user' or 'ai'
  content     String   @db.Text
  fileIds     String[] @default([]) // Array of attached file IDs
  toolUsed    String?  // Tool that was executed (if any)
  toolResult  Json?    // Result of the tool execution
  toolArgs    Json?    // Arguments passed to the tool
  thinking    String?  @db.Text // AI's internal reasoning/thoughts
  
  sessionId   String
  session     ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
}

model AgentActivity {
  id        String   @id @default(cuid())
  type      String   // 'info', 'success', 'warning', 'error'
  title     String
  message   String   @db.Text
  toolUsed  String?
  fileId    String?  // Optional link to a specific file
  
  sessionId String?
  session   ChatSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model AgentJob {
  id          String   @id @default(cuid())
  type        String
  status      String   @default("queued") // queued, running, succeeded, failed
  payload     Json
  result      Json?
  error       String?
  workerId    String?
  attempts    Int      @default(0)
  approved    Boolean  @default(false)
  approvedAt  DateTime?

  sessionId   String?
  session     ChatSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Feedback Loop Fields
  parentJobId    String?
  parent         AgentJob?    @relation("JobChain", fields: [parentJobId], references: [id])
  children       AgentJob[]   @relation("JobChain")
  
  iteration      Int          @default(0)
  maxIterations  Int          @default(5)
  feedback       Json?        // Agent's reflection on results
  nextAction     String?      // What agent plans to do next
  
  // Autonomy Control
  autonomyLevel  String       @default("manual") // manual, semi, full
  requiresReview Boolean      @default(false)
  
  // Communication
  messages       AgentMessage[]

  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, createdAt])
}

model AgentMessage {
  id          String   @id @default(cuid())
  jobId       String
  job         AgentJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  
  fromAgent   String   // worker-123, cognitive-brain, etc.
  toAgent     String?  // null = broadcast
  messageType String   // request, response, feedback, error
  content     Json
  
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model PrototypeData {
  id        String   @id @default(cuid())
  appId     String   // The Folder ID acts as the App ID
  collection String  // "leads", "todos", "settings"
  data      Json
  
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([appId, collection])
}

model Skill {
  id              String   @id @default(cuid())
  name            String
  description     String   @db.Text
  category        String   // 'receipt_processing', 'file_management', 'fiscal_operations', 'workspace_organization', 'custom'
  icon            String?  @default("Zap")
  enabled         Boolean  @default(true)
  
  // Skill definition
  schema          Json     // Gemini function declaration schema
  capabilities    String[] @default([]) // What this skill can do
  
  // Execution strategy
  handlerType     String   @default("workflow") // 'workflow', 'builtin', 'custom'
  handlerRef      String?  // Reference to built-in handler or custom code
  workflow        Json?    // Array of WorkflowStep for workflow-based skills
  
  // Metadata
  tags            String[] @default([])
  isBuiltin       Boolean  @default(false) // Built-in skills vs user-defined
  
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, enabled])
  @@index([category])
}

// Process Manager & Health Monitoring

model ProcessRegistry {
  id              String    @id @default(cuid())
  name            String
  type            String    // "dev-server", "background-job", "external-tool"
  port            Int?
  pid             Int?
  path            String    // Working directory
  command         String    // Command that started it
  status          String    // "running", "stopped", "error", "healthy", "unhealthy"
  healthUrl       String?   // URL to check health (e.g., http://localhost:3000/api/health)
  healthCheckType String?   // "http", "port", "process", "script"
  healthInterval  Int?      // Health check interval in ms
  
  startedAt       DateTime  @default(now())
  stoppedAt       DateTime?
  lastHealthCheck DateTime?
  healthStatus    String?   // "healthy", "unhealthy", "unknown"
  responseTime    Int?      // Last health check response time in ms
  errorCount      Int       @default(0)
  
  metadata        Json?     // Additional data (env vars, config, etc.)
  
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@index([userId, status])
  @@index([port])
}

model ToolConfiguration {
  id              String    @id @default(cuid())
  name            String    @unique // "firebase-cli", "vercel-cli", etc.
  displayName     String    // "Firebase CLI"
  type            String    // "cli", "api", "service"
  enabled         Boolean   @default(true)
  
  // Installation & Path
  path            String?   // Executable path
  version         String?   // Detected version
  
  // Configuration
  config          Json      // Tool-specific configuration
  
  // Health Check
  healthCheck     Json?     // { command, expectedOutput, interval }
  lastHealthCheck DateTime?
  healthStatus    String?   // "healthy", "unhealthy", "not-installed"
  
  // Metadata
  description     String?
  icon            String?   @default("Tool")
  category        String?   // "deployment", "database", "ci-cd", "custom"
  
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@index([userId, enabled])
}

// User Profile & Preferences
model UserProfile {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Profile Info
  displayName     String?
  avatarUrl       String?
  bio             String?   @db.Text
  timezone        String    @default("UTC")
  locale          String    @default("en-US")
  
  // Preferences
  theme           String    @default("system") // "light", "dark", "system"
  compactMode     Boolean   @default(false)
  notifications   Json      @default("{\"email\": true, \"push\": true, \"desktop\": true}")
  
  // AI Preferences
  aiPersonality   String    @default("professional") // "professional", "casual", "technical"
  defaultModel    String    @default("gemini-2.0-flash")
  temperature     Float     @default(0.7)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// App-level Settings
model AppSettings {
  id              String    @id @default(cuid())
  userId          String    
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  category        String    // "general", "ai", "integrations", "security", "advanced"
  key             String
  value           Json
  description     String?
  isSecret        Boolean   @default(false)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@unique([userId, category, key])
  @@index([userId, category])
}

// App Resource Configuration (follows Cloud Run / Replit / EDI patterns)
model AppResource {
  id              String    @id @default(cuid())
  
  // Identity
  name            String    // user-friendly name
  slug            String    // URL-safe identifier
  type            String    // "api", "database", "storage", "compute", "ai-model", "messaging", "edi", "custom"
  provider        String    // "firebase", "supabase", "gcp", "aws", "azure", "openai", "anthropic", "custom"
  
  // Status
  status          String    @default("pending") // "pending", "active", "error", "disabled"
  lastSyncedAt    DateTime?
  healthStatus    String?   // "healthy", "degraded", "unhealthy", "unknown"
  
  // Configuration (based on Cloud Run YAML / Kubernetes specs)
  spec            Json      // The main resource specification
  /* spec structure example:
    {
      "apiVersion": "v1",
      "kind": "ApiConnection",
      "metadata": { "labels": {}, "annotations": {} },
      "spec": {
        "template": {
          "containers": [{ "env": [], "resources": { "limits": {}, "requests": {} } }]
        },
        "traffic": [],
        "scaling": { "minInstances": 0, "maxInstances": 10 }
      }
    }
  */
  
  // Environment Variables (key-value pairs, similar to Replit Secrets)
  envVars         Json      @default("[]")
  /* envVars structure:
    [
      { "key": "API_KEY", "value": "secret", "isSecret": true, "scope": "runtime" },
      { "key": "DEBUG", "value": "true", "isSecret": false, "scope": "build" }
    ]
  */
  
  // Resource Limits (Cloud Run style)
  limits          Json      @default("{}")
  /* limits structure:
    {
      "cpu": "1000m",
      "memory": "512Mi",
      "timeoutSeconds": 300,
      "maxRequestsPerContainer": 80,
      "minInstances": 0,
      "maxInstances": 100
    }
  */
  
  // EDI Configuration (for EDI type resources)
  ediConfig       Json?
  /* ediConfig structure (X12 / EDIFACT):
    {
      "standard": "X12" | "EDIFACT",
      "version": "005010X222A2",
      "transactionSets": ["850", "810", "997"],
      "interchange": { 
        "senderId": "SENDERID", 
        "receiverId": "RECEIVERID",
        "qualifier": "ZZ"
      },
      "validation": { "strict": true, "autoAck": true }
    }
  */
  
  // Endpoints (auto-discovered or manually configured)
  endpoints       Json      @default("[]")
  /* endpoints structure:
    [
      { "name": "primary", "url": "https://...", "type": "rest", "auth": "bearer" },
      { "name": "webhook", "url": "https://...", "type": "webhook", "events": ["create", "update"] }
    ]
  */
  
  // Credentials reference
  credentials     ResourceCredential[]
  
  // Linked Apps
  linkedApps      Json      @default("[]") // Array of app IDs that use this resource
  
  // Metadata
  description     String?   @db.Text
  documentation   String?   // URL to docs
  icon            String?   @default("Box")
  tags            String[]  @default([])
  
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@unique([userId, slug])
  @@index([userId, type])
  @@index([userId, provider])
  @@index([status])
}

// Resource Credentials (encrypted secrets storage)
model ResourceCredential {
  id              String    @id @default(cuid())
  
  resourceId      String
  resource        AppResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  
  // Credential Info
  name            String    // "api_key", "service_account", "oauth_token", etc.
  type            String    // "api_key", "oauth2", "service_account", "basic_auth", "certificate"
  
  // Encrypted value (use app-level encryption)
  encryptedValue  String    @db.Text
  
  // OAuth specific
  accessToken     String?   @db.Text
  refreshToken    String?   @db.Text
  tokenExpiresAt  DateTime?
  scopes          String[]  @default([])
  
  // Metadata
  isActive        Boolean   @default(true)
  lastUsedAt      DateTime?
  expiresAt       DateTime?
  
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@index([resourceId])
  @@index([userId, type])
}

