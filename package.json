    "agent:start": "tsx src/cli/start-agent-worker.ts",
    "agent:monitor": "tsx src/cli/agent-monitor.ts",
    "shell": "tsx src/cli/interactive-shell.ts",
    "omni-shell": "tsx src/cli/interactive-shell.ts",
    "db:migrate": "prisma migrate dev",
    "sync:files": "tsx src/scripts/sync_uploads.ts",
    "import:docker-skill": "tsx scripts/import-docker-skill.ts"
  },
