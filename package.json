    "start": "next start",
    "lint": "eslint",
    "db:local:up": "node scripts/setup-local-db-native.mjs --start-only",
    "db:local:down": "node scripts/setup-local-db-native.mjs --stop-only",
    "db:local:logs": "powershell -NoProfile -Command Get-Content .local/postgres/postgres.log -Wait",
    "db:local:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:local:setup": "node scripts/setup-local-db-native.mjs",
    "db:docker:up": "docker compose -f docker-compose.db.yml up -d",
    "db:docker:down": "docker compose -f docker-compose.db.yml down",
    "db:docker:logs": "docker compose -f docker-compose.db.yml logs -f db",
