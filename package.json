    "dev:agents": "npm run agent:start",
    "dev:next": "next dev --webpack",
    "dev:turbo": "next dev --turbo",
    "dev:safe": "next dev --webpack",
    "dev:omni-shell": "concurrently -n next,shell -c cyan,magenta \"npm run dev:next\" \"npm run omni-shell\"",
    "dev:app": "node scripts/dev-app.mjs",
    "dev:app:omni-shell": "node scripts/dev-app-omni.mjs",
