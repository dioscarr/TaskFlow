### 5. Implementation Details

#### 5.1. Video Download and Audio Extraction

The backend will use `yt-dlp` to download YouTube videos and `ffmpeg` to extract audio from the downloaded video. The downloaded video and extracted audio will be stored temporarily on the server.

```typescript
// backend/src/services/youtube.ts

import { exec } from 'child_process';
import fs from 'fs';
import path from 'path';
import { promisify } from 'util';

const execAsync = promisify(exec);

export async function downloadYouTubeVideo(youtubeUrl: string): Promise<string> {
  const videoTitle = await getVideoTitle(youtubeUrl);
  const filename = `${videoTitle.replace(/[^a-zA-Z0-9]/g, '_')}.mp4`;
  const outputPath = path.join(__dirname, '../../../tmp', filename);
  // Ensure the tmp directory exists
  fs.mkdirSync(path.join(__dirname, '../../../tmp'), { recursive: true });

  try {
    const command = `yt-dlp -o "${outputPath}" ${youtubeUrl}`;
    console.log(`Executing command: ${command}`);
    const { stdout, stderr } = await execAsync(command);
    console.log(`stdout: ${stdout}`);
    console.error(`stderr: ${stderr}`);
    return filename;
  } catch (error: any) {
    console.error(`Error downloading video: ${error}`);
    throw new Error(`Failed to download video: ${error.message}`);
  }
}

export async function extractAudio(videoFilename: string): Promise<string> {
  const audioFilename = videoFilename.replace(/\.mp4$/, '.wav');
  const videoPath = path.join(__dirname, '../../../tmp', videoFilename);
  const audioPath = path.join(__dirname, '../../../tmp', audioFilename);

  try {
    const command = `ffmpeg -i "${videoPath}" -vn -acodec pcm_s16le -ac 1 -ar 16000 "${audioPath}"`;
    console.log(`Executing command: ${command}`);
    const { stdout, stderr } = await execAsync(command);
    console.log(`stdout: ${stdout}`);
    console.error(`stderr: ${stderr}`);
    return audioFilename;
  } catch (error: any) {
    console.error(`Error extracting audio: ${error}`);
    throw new Error(`Failed to extract audio: ${error.message}`);
  }
}

async function getVideoTitle(youtubeUrl: string): Promise<string> {
    try {
        const command = `yt-dlp --get-title ${youtubeUrl}`;
        const { stdout, stderr } = await execAsync(command);

        if (stderr) {
            console.error(`Error getting video title: ${stderr}`);
            throw new Error(`Failed to get video title: ${stderr}`);
        }

        return stdout.trim();
    } catch (error: any) {
        console.error(`Error getting video title: ${error}`);
        throw new Error(`Failed to get video title: ${error.message}`);
    }
}
```

#### 5.2. ASR Transcription

The backend will use either Google Cloud Speech-to-Text or Whisper for ASR transcription. The choice of service will be configurable.

```typescript
// backend/src/services/asr.ts

// Example using Google Cloud Speech-to-Text
import { SpeechClient } from '@google-cloud/speech';
import fs from 'fs';
import path from 'path';

export async function transcribeAudioGoogle(audioFilename: string): Promise<string> {
  const client = new SpeechClient();
  const audioPath = path.join(__dirname, '../../../tmp', audioFilename);
  const audio = {
    content: fs.readFileSync(audioPath).toString('base64'),
  };
  const config = {
    encoding: 'LINEAR16',
    sampleRateHertz: 16000,
    languageCode: 'en-US',
  };
  const request = {
    audio: audio,
    config: config,
  };

  try {
    const [response] = await client.recognize(request as any);
    const transcription = response.results
      .map(result => result.alternatives[0].transcript)
      .join('\n');
    return transcription;
  } catch (error: any) {
    console.error(`Error transcribing audio: ${error}`);
    throw new Error(`Failed to transcribe audio: ${error.message}`);
  }
}

